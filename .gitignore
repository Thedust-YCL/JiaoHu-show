# ---- 依赖 ----
node_modules/

# ---- 构建产物（可随时 npm run build 再生）----
dist/

# ---- 测试 / 自检输出（npm run shots 每次覆盖写入）----
verify/
*.report.json

# ---- 编辑器与系统文件 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
npm-debug.log*
*.tmp
*.temp

# ---- 误建的垃圾文件（命令行重定向残留，0 字节且被进程占用）----
\{console.log*
console.log*
